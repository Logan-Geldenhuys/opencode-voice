{
  "name": "opencode-nome-voice",
  "version": "0.1.0",
  "description": "Speech-to-text and text-to-speech for OpenCode. Hold a key to dictate, or leave it listening and say \"hey nome\" to send everything you have thought aloud. Transcription and normalization run through any OpenAI-compatible endpoint, including a corporate gateway.",
  "keywords": [
    "continuous-listening",
    "nome",
    "opencode",
    "piper",
    "plugin",
    "speech-to-text",
    "stt",
    "text-to-speech",
    "tts",
    "voice",
    "wake-word",
    "whisper"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Logan-Geldenhuys/opencode-voice.git"
  },
  "files": [
    "index.js",
    "lib"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./tui": {
      "import": "./index.js"
    }
  },
  "scripts": {
    "lint": "npx oxlint .",
    "fmt": "npx oxfmt --check .",
    "fmt:fix": "npx oxfmt --write .",
    "test": "node --test",
    "check": "npm run lint && npm run fmt",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0"
  }
}
